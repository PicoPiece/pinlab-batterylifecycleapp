# Production environment template for PinLab Battery Lifecycle App
# Copy to .env on the production host, fill secrets, chmod 600.
# Do not commit the filled file.

POSTGRES_DB=pinlab
POSTGRES_USER=pinlab
POSTGRES_PASSWORD=change-me-production-db-password

# Generate: openssl rand -hex 64
APP_SECRET_KEY=change-me-production-app-secret-at-least-32-bytes

ENVIRONMENT=production
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
ENABLE_DOCS=false

# Initial admin seed only; do not reuse demo credentials.
ADMIN_EMAIL=admin@pinlab.com
ADMIN_PASSWORD=change-me-production-admin-password

MAX_UPLOAD_MB=20
CORS_ORIGINS=https://pinlab-app.picopiece.com

# Optional release image tag for rollback-friendly deploys
APP_IMAGE_TAG=rc-placeholder
