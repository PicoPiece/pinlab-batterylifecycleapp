# PinLab Battery Lifecycle App — local environment template
# Copy to .env, fill values, chmod 600. Never commit .env.

POSTGRES_DB=pinlab
POSTGRES_USER=pinlab
POSTGRES_PASSWORD=change-me-strong-db-password

# Generate: openssl rand -hex 64
APP_SECRET_KEY=change-me-strong-app-secret-at-least-32-bytes

ENVIRONMENT=development
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Initial admin seed. Required only for `python -m app.seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-admin-password

MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
