{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pinlab.picopiece.com/schemas/mqtt/telemetry-v1.schema.json",
  "title": "PinLab MQTT Telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "gateway_id", "battery_slot", "message_id",
    "measured_at", "time_quality", "source", "protocol",
    "pack_voltage_v", "pack_current_a", "soc_pct", "soh_pct",
    "capacity_remaining_ah", "capacity_full_ah",
    "cell_voltages_mv", "temperatures_c"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "gateway_id": {"type": "string", "pattern": "^GW-[A-Za-z0-9_-]{1,64}$"},
    "battery_slot": {"type": "integer", "minimum": 0, "maximum": 15},
    "message_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "measured_at": {"type": "string", "format": "date-time"},
    "time_quality": {"type": "string", "enum": ["device_utc", "gateway_ntp", "gateway_uptime", "unknown"]},
    "source": {"type": "string", "enum": ["REAL_BMS", "SIMULATED"]},
    "protocol": {"const": "PYLON_485"},
    "pack_voltage_v": {"type": "number", "minimum": 0, "maximum": 1000},
    "pack_current_a": {"type": "number", "minimum": -1000, "maximum": 1000},
    "soc_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "soh_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "capacity_remaining_ah": {"type": "number", "minimum": 0, "maximum": 10000},
    "capacity_full_ah": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
    "cell_voltages_mv": {
      "type": "array", "minItems": 16, "maxItems": 16,
      "items": {"type": "integer", "minimum": 1000, "maximum": 5000}
    },
    "temperatures_c": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {"type": "number", "minimum": -40, "maximum": 100}
    }
  }
}
